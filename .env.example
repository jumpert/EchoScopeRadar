# Copiar a .env junto al ejecutable o en el directorio de trabajo del proyecto.
# Las variables del sistema tienen precedencia. No se expanden expresiones.
# También puede indicarse --env-file /ruta/instalacion.env o ECHOSCOPE_ENV_FILE.

# Usar una carpeta local fuera de OneDrive para los datos de ejecución.
# ECHOSCOPE_DATA_DIR=C:/EchoScopeRadar/datos
# ECHOSCOPE_DATA_DIR=/var/lib/echoscope
# Si se omite DATABASE_URL se crean bases separadas según el comando.
# ECHOSCOPE_DATABASE_URL=sqlite+aiosqlite:///C:/EchoScopeRadar/datos/radar.sqlite
# ECHOSCOPE_DATABASE_URL=sqlite+aiosqlite:////var/lib/echoscope/radar.sqlite
ECHOSCOPE_BIND=127.0.0.1
ECHOSCOPE_PORT=8765
ECHOSCOPE_DEMO_PORT=8766

# Servidor compartido HTTPS. Cada cuenta conserva su propia base.
# ECHOSCOPE_SERVER_DIR=/var/lib/echoscope/cuentas
# ECHOSCOPE_ORIGIN=https://radar.example.org:8765
# ECHOSCOPE_TLS_CERT=/etc/echoscope/fullchain.pem
# ECHOSCOPE_TLS_KEY=/etc/echoscope/privkey.pem
# ECHOSCOPE_MASTER_KEY=GENERAR_Y_GUARDAR_FUERA_DEL_REPOSITORIO

# Archivo YAML inicial para instalaciones nuevas, independiente del archivo .env.
# ECHOSCOPE_SOURCE_CONFIG=/etc/echoscope/fuentes.yaml
ECHOSCOPE_POLL_SLOTS=4
ECHOSCOPE_STREAM_SLOTS=2
ECHOSCOPE_RETRIES=3
ECHOSCOPE_SHUTDOWN_TIMEOUT_S=5
ECHOSCOPE_SESSION_MESSAGE_LIMIT=200
ECHOSCOPE_RETENTION_INTERVAL_S=86400
ECHOSCOPE_SQLITE_BUSY_TIMEOUT_MS=1500
ECHOSCOPE_DATABASE_POOL_SIZE=5
ECHOSCOPE_DATABASE_POOL_TIMEOUT_S=10
ECHOSCOPE_API_MAX_BODY_BYTES=5242880
ECHOSCOPE_REQUEST_MAX_BYTES=65536
ECHOSCOPE_LOGIN_ATTEMPTS_PER_MINUTE=8
ECHOSCOPE_PASSWORD_HASH_SLOTS=4
ECHOSCOPE_SESSION_TTL_S=28800
ECHOSCOPE_MAX_SESSIONS=512
ECHOSCOPE_MAX_WORKSPACES=32
ECHOSCOPE_LOCAL_IDLE_TIMEOUT_S=180

# Solo para el modo local. En servidor se usan las claves privadas de cada cuenta.
# ECHOSCOPE_YOUTUBE_KEY=
# ECHOSCOPE_BRAVE_KEY=
# ECHOSCOPE_TAVILY_KEY=
# ECHOSCOPE_SERPER_KEY=
# ECHOSCOPE_DISQUS_KEY=
# SearXNG es una dirección administrada global, HTTPS pública y con JSON habilitado.
# ECHOSCOPE_SEARXNG_URL=https://buscador.example.org
