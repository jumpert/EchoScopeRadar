# Configuración persistente. Reiniciar EchoScope tras modificarla.
# Windows: %LOCALAPPDATA%/EchoScopeRadar/instalacion.env
# Linux: ~/.local/share/EchoScopeRadar/instalacion.env
ECHOSCOPE_BIND=127.0.0.1
ECHOSCOPE_PORT=8765
ECHOSCOPE_DEMO_PORT=8766
# ECHOSCOPE_DATA_DIR=C:/Users/TU_USUARIO/AppData/Local/EchoScopeRadar
# ECHOSCOPE_DATA_DIR=/home/TU_USUARIO/.local/share/EchoScopeRadar

# Dominio futuro: modo servidor con cuentas y HTTPS.
# El dominio exacto de acceso va en ORIGIN; no termina en /.
# DNS y certificado deben corresponder al dominio elegido.
# ECHOSCOPE_ORIGIN=https://radar.ejemplo.uy
# ECHOSCOPE_SERVER_DIR=/var/lib/echoscope/cuentas
# ECHOSCOPE_TLS_CERT=/etc/echoscope/tls/fullchain.pem
# ECHOSCOPE_TLS_KEY=/etc/echoscope/tls/privkey.pem
# ECHOSCOPE_MASTER_KEY=CLAVE_MAESTRA_PROPIA
# BIND controla la interfaz de escucha, PORT el puerto del proceso.
# Un proxy HTTPS puede publicar el dominio en 443 y conservar el proceso en 8765.
# ECHOSCOPE_YOUTUBE_KEY=CLAVE_PROPIA
# ECHOSCOPE_DISQUS_KEY=CLAVE_PROPIA
