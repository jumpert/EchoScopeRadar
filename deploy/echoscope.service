[Unit]
Description=EchoScope Radar shared monitoring server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=echoscope
Group=echoscope
WorkingDirectory=/opt/echoscope
ExecStart=/opt/echoscope/.venv/bin/echoscope-web --env-file /etc/echoscope/instalacion.env --no-browser
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
